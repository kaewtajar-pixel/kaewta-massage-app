# Database
DATABASE_URL=mysql://user:password@host:3306/kaewta_db

# Auth
JWT_SECRET=your-super-secret-key-here

# App
VITE_APP_ID=kaewta-massage-app
NODE_ENV=production

# OAuth (ถ้าใช้ login ผ่าน Manus OAuth ให้ข้ามไปก่อน)
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Optional: Google Maps API
VITE_GOOGLE_MAPS_API_KEY=

# Optional: AI / Forge API (ถ้าใช้ AIChatBox)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional: S3/Storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
